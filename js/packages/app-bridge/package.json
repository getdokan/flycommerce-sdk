{
  "name": "@flycommerce/app-bridge",
  "description": "Run a FlyCommerce app inside the merchant dashboard: session tokens, navigation, title bar, dialogs and dashboard context. Includes React hooks and a server-side session token verifier.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "FlyCommerce",
  "bugs": {
    "url": "https://github.com/getdokan/flycommerce-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/getdokan/flycommerce-sdk/tree/main/js/packages/app-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdokan/flycommerce-sdk.git",
    "directory": "js/packages/app-bridge"
  },
  "keywords": [
    "flycommerce",
    "app-bridge",
    "embedded-apps",
    "sdk",
    "ecommerce"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./storefront": {
      "types": "./dist/storefront.d.ts",
      "import": "./dist/storefront.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test-build/__tests__/*.test.js && vitest run",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vitest": "^5.0.1"
  }
}
