{
  "name": "@flycommerce/cli",
  "description": "The FlyCommerce command line: sign in to the developer portal, link app-config.json to an app, develop on a real store through a tunnel, release versions with changelogs from your commits, and submit for review.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "FlyCommerce",
  "bugs": {
    "url": "https://github.com/getdokan/flycommerce-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/getdokan/flycommerce-sdk/tree/main/js/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdokan/flycommerce-sdk.git",
    "directory": "js/packages/cli"
  },
  "keywords": [
    "flycommerce",
    "cli",
    "embedded-apps",
    "sdk",
    "ecommerce"
  ],
  "bin": {
    "flycommerce": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test-build/__tests__/*.test.js",
    "check:package": "publint --strict"
  },
  "dependencies": {
    "@flycommerce/app-server": "^0.1.0"
  }
}
